# SURAKSHA Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database Configuration (MySQL 8.0+ or fallback to sqlite:///./suraksha.db)
DATABASE_URL=sqlite:///./suraksha.db
# For MySQL production:
# DATABASE_URL=mysql+pymysql://suraksha_user:SurakshaSecret2026@localhost:3306/suraksha_db

# Security & JWT Token Authentication
SECRET_KEY=suraksha-super-secure-production-jwt-token-key-2026-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Operational Supervisor & Jev Boundary Integration
SURAKSHA_OPERATOR_API_KEY=SURAKSHA-OP-KEY-98421
JEV_SUPERVISOR_MODE=OFFLINE_DETERMINISTIC
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

