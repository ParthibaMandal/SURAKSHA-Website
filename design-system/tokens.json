{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "SURAKSHA Flood Interface Tokens",
  "version": "1.0.0",
  "color": {
    "primitive": {
      "graphite": {
        "950": { "value": "#101213", "type": "color" },
        "900": { "value": "#141718", "type": "color" },
        "850": { "value": "#191E1F", "type": "color" },
        "800": { "value": "#232A2B", "type": "color" }
      },
      "river": {
        "400": { "value": "#A9C9C2", "type": "color" },
        "500": { "value": "#729D95", "type": "color" }
      },
      "status": {
        "confirmed": { "value": "#9BBDA2", "type": "color" },
        "warning": { "value": "#D8B575", "type": "color" },
        "critical": { "value": "#D78379", "type": "color" }
      },
      "text": {
        "primary": { "value": "#F1F2EE", "type": "color" },
        "secondary": { "value": "#A3ADAB", "type": "color" },
        "muted": { "value": "#74807D", "type": "color" }
      },
      "border": {
        "default": { "value": "#2C3536", "type": "color" },
        "strong": { "value": "#394344", "type": "color" }
      }
    },
    "semantic": {
      "background": {
        "canvas": { "value": "{color.primitive.graphite.950.value}", "type": "color" },
        "subtle": { "value": "{color.primitive.graphite.900.value}", "type": "color" },
        "surface": { "value": "{color.primitive.graphite.850.value}", "type": "color" },
        "surfaceRaised": { "value": "{color.primitive.graphite.800.value}", "type": "color" }
      },
      "text": {
        "primary": { "value": "{color.primitive.text.primary.value}", "type": "color" },
        "secondary": { "value": "{color.primitive.text.secondary.value}", "type": "color" },
        "muted": { "value": "{color.primitive.text.muted.value}", "type": "color" }
      },
      "state": {
        "confirmed": { "value": "{color.primitive.status.confirmed.value}", "type": "color" },
        "syntheticOrPending": { "value": "{color.primitive.status.warning.value}", "type": "color" },
        "critical": { "value": "{color.primitive.status.critical.value}", "type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "interface": { "value": "Inter, system-ui, sans-serif" },
      "technical": { "value": "ui-monospace, SFMono-Regular, monospace" }
    },
    "fontSize": {
      "caption": { "value": "0.75rem" },
      "body": { "value": "1rem" },
      "section": { "value": "2rem" },
      "display": { "value": "clamp(2.75rem, 5.5vw, 4.375rem)" }
    }
  },
  "spacing": {
    "1": { "value": "4px" },
    "2": { "value": "8px" },
    "3": { "value": "12px" },
    "4": { "value": "16px" },
    "6": { "value": "24px" },
    "8": { "value": "32px" },
    "12": { "value": "48px" },
    "16": { "value": "64px" }
  },
  "radius": {
    "small": { "value": "8px" },
    "medium": { "value": "12px" },
    "large": { "value": "18px" },
    "pill": { "value": "999px" }
  }
}
